<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- SPIKE ONLY (issue #6): the backend is plain HTTP on an IP, so App
	     Transport Security has to be relaxed. The real app talks HTTPS to a
	     hostname and must NOT ship this. Other keys are still generated by
	     GENERATE_INFOPLIST_FILE=YES and merged on top of this file. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
