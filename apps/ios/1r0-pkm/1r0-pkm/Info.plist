<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Font del linguaggio visivo Glass Dark (ADR-0023). File in
	     Resources/Fonts/, licenza OFL. -->
	<key>UIAppFonts</key>
	<array>
		<string>SpaceGrotesk-Variable.ttf</string>
		<string>Manrope-Variable.ttf</string>
	</array>

	<!-- HealthKit (ADR-0004 amendata da ADR-0027): lettura peso corporeo /
	     acqua / energia attiva; scrittura energia + macro dei pasti loggati. -->
	<key>NSHealthShareUsageDescription</key>
	<string>1r0-pkm legge da Apple Salute il peso corporeo, l'acqua e l'energia attiva per l'andamento e la quota giornaliera.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>1r0-pkm scrive in Apple Salute l'energia e i macronutrienti dei pasti che registri nella dieta.</string>

	<!-- Scan barcode alimenti (ADR-0018): VisionKit DataScannerViewController. -->
	<key>NSCameraUsageDescription</key>
	<string>1r0-diet usa la fotocamera per scansionare il codice a barre dei prodotti alimentari.</string>

	<!-- Sync outbox (ADR-0006) + motore Promemoria (ADR-0027) in background:
	     BGAppRefreshTask. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>dev.1r0.pkm.sync</string>
		<string>dev.1r0.pkm.reminders</string>
	</array>

	<!-- TEMPORANEO: backend HTTP su IP nudo (niente dominio/TLS). Eccezione
	     ATS solo per quell'host — togliere quando c'è dominio + HTTPS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>100.31.154.129</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
