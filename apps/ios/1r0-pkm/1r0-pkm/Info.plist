<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Font del linguaggio visivo Glass Dark (ADR-0023). File in
	     Resources/Fonts/, licenza OFL. -->
	<key>UIAppFonts</key>
	<array>
		<string>SpaceGrotesk-Variable.ttf</string>
		<string>Manrope-Variable.ttf</string>
	</array>

	<!-- TEMPORANEO: backend HTTP su IP nudo (niente dominio/TLS). Eccezione
	     ATS solo per quell'host — togliere quando c'è dominio + HTTPS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>100.31.154.129</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
