# Copy to infra/.env and fill in. .env is gitignored.

# --- Postgres ---
POSTGRES_USER=onepkm
POSTGRES_PASSWORD=change-me-use-a-long-random-string
POSTGRES_DB=onepkm

# --- API service ---
# The single static bearer token every client sends as
#   Authorization: Bearer <API_KEY>
# Generate once, e.g.:  openssl rand -hex 32
API_KEY=change-me-generate-a-long-random-string

# Only needed for the AI routes (/v1/exercises/ai-import, /v1/coaching/review).
# Server-side only — never ship this to the iOS/Watch client.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Ricerca alimenti USDA (ADR-0018). "DEMO_KEY" funziona ma è throttlato;
# chiave gratuita: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=DEMO_KEY

# --- Caddy ---
# ":80"  -> plain HTTP on port 80, reachable by the EC2 public IP right away.
# Set to a hostname (api.example.com) for automatic HTTPS once DNS points here.
API_DOMAIN=:80
